    {
        "id": "86f80b54f924b693",
        "type": "http in",
        "z": "3dbd3084c7f4ca94",
        "name": "GET /api/items",
        "url": "/api/items/:id",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 220,
        "y": 480,
        "wires": [
            [
                "76edb72516ef762a"
            ]
        ]
    },
    {
        "id": "76edb72516ef762a",
        "type": "function",
        "z": "3dbd3084c7f4ca94",
        "name": "items handler",
        "func": "const id = msg.req.params.id;\nconst detail = msg.req.query.detail;\nconst items = {\n    \"1\": { id: 1, name: \"Ноутбук\", price: 1500 },\n    \"2\": { id: 2, name: \"Мышь\", price: 25 },\n    \"3\": { id: 3, name: \"Клавиатура\", price: 75 }\n};\nif (!id || isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"Параметр id должен быть числом\",\n        example: \"/api/items/1\"\n    };\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\n    return msg;\n}\nif (!items[id]) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Not Found\",\n        message: `Товар с id=${id} не найден`,\n        available: Object.keys(items)\n    };\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\n    return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = {\n    item: items[id],\n    detail: detail === \"full\" ? \"Полная информация\" : \"Краткая информация\"\n};\nmsg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 480,
